{
	admin off
	auto_https off
}

:80 {
	@api host {$API_HOST}
	handle @api {
		reverse_proxy api:18080
	}

	@app host {$APP_HOST}
	handle @app {
		reverse_proxy consumer-web:18081
	}

	@admin host {$ADMIN_HOST}
	handle @admin {
		reverse_proxy admin-web:18082
	}

	handle {
		respond "StrivePay edge" 200
	}
}
